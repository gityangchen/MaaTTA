{
    // 通用 UI 的项目描述。文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    "interface_version": 2,
    "name": "MaaTTA",
    "label": "塔塔冒险队自动挂机",
    "description": "塔塔冒险队 Windows + MuMu 自动挂机。当前仓库是一期（领奖/邮件）骨架，模板图尚未采集。",
    "contact": "https://github.com/gityangchen/MaaTTA",
    "license": "MIT",
    "welcome": "欢迎使用 MaaTTA。一期流水线已搭好，但 image/phase1 下还没有真机裁图，直接跑会在主界面锚点超时。请先按 docs/zh_cn/phase1_checklist.md 裁图。CDK 默认开发放行，不会连接发码服务器。",
    "github": "https://github.com/gityangchen/MaaTTA",
    "version": "0.1.0",
    // Mirror酱未开通，保持关闭。
    // "mirrorchyan_rid": "MaaTTA",
    "controller": [
        {
            "name": "MuMu 12",
            "label": "MuMu 12（ADB）",
            "description": "默认 127.0.0.1:16384。模拟器锁定 1280×720、DPI 240。display_short_side 720，模板图按短边 720 裁。点击只用 AdbShell（adb shell input tap）。MuMu 上默认的 Maatouch / minitouch / EmulatorExtras 会报点击成功，但触摸坐标映偏，邮箱打不开。",
            "type": "Adb",
            "display_short_side": 720,
            // 官方 Project Interface v2 不定义 Adb 的 input / screencap，协议写的是自动检测。
            // 本仓库打包的通用 UI 是 MFAAvalonia，它会读 adb.input 这个整数位掩码并写入连接设置：
            // 1 = AdbShell，2 = MinitouchAndAdbKey，4 = Maatouch，8 = EmulatorExtras。
            // 必须是数字 1。写成字符串 "AdbShell" 时，对方按 long? 反序列化，这个控制器会加载失败。
            // MaaDebugger 的 Connect 不读该字段，仍用 AdbController 默认输入。Python 连接见 agent/mumu_adb.py。
            "adb": {
                "input": 1
            }
        }
        // 不使用 Win32。游戏跑在 MuMu 里，只走 ADB。
    ],
    "resource": [
        {
            "name": "默认",
            "path": [
                "./resource"
            ]
        }
    ],
    "group": [
        {
            "name": "phase1",
            "label": "一期 · 领奖/邮件",
            "description": "主界面锚点、邮件、签到/七日/活动领奖、弹珠焚决领奖，以及维护/更新/网络弹窗。"
        },
        {
            "name": "debug",
            "label": "调试",
            "description": "裁图和 CDK 桩。不包含二期及以后的正式任务。"
        }
    ],
    // 开发时 CWD 是本文件所在的 assets/，所以脚本路径是 ../agent/main.py。
    // tools/install.py 打包时会把这一条改成 ./agent/main.py（与 interface.json 同级）。
    "agent": {
        "child_exec": "python",
        "child_args": [
            "../agent/main.py"
        ]
    },
    "task": [
        {
            "name": "一期·领奖邮件",
            "label": "一期·领奖邮件",
            "entry": "Phase1AwardMail",
            "group": [
                "phase1"
            ],
            "default_check": true,
            "description": "CDK base 门闩后，从主界面依次尝试好友（邮件在好友页）、签到、七日、活动领奖、弹珠焚决。模板未裁齐时会在对应节点超时。",
            "controller": [
                "MuMu 12"
            ]
        },
        {
            "name": "调试·主界面锚点",
            "label": "调试·主界面锚点",
            "entry": "HomeAnchorProbe",
            "group": [
                "debug"
            ],
            "default_check": false,
            "description": "只识别 image/phase1/home/anchor.png，不点击。用来确认 1280×720 / 短边 720 的裁图。",
            "controller": [
                "MuMu 12"
            ]
        },
        {
            "name": "CDK 校验(开发)",
            "label": "CDK 校验(开发)",
            "entry": "CdkCheckDev",
            "group": [
                "debug"
            ],
            "default_check": false,
            "description": "依次走 base 与 activity。默认放行。把 MAATTA_DEV_SKIP_CDK 设为 0 后，空的 MAATTA_CDK 会失败。",
            "controller": [
                "MuMu 12"
            ]
        }
    ]
    // 二期每日任务、三期刷关、四期钓鱼赛跑都还没有任务入口。
    // 四期附属 MVP 礼盒（搜 UID → 拜访家园 → 领盒 + 份数上限）只在
    // assets/resource/pipeline/phase4/README.md 留了说明，授权档位预留 activity。
}
